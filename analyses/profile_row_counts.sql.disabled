config(
    enabled=false
)

-- Row counts across bronze sources (run after dbt seed)
select 'raw_patients' as table_name, count(*) as row_count from {{ source('bronze', 'raw_patients') }}
union all select 'raw_encounters', count(*) from {{ source('bronze', 'raw_encounters') }}
union all select 'raw_claims', count(*) from {{ source('bronze', 'raw_claims') }}
union all select 'raw_claims_transactions', count(*) from {{ source('bronze', 'raw_claims_transactions') }}
union all select 'raw_observations', count(*) from {{ source('bronze', 'raw_observations') }}
order by row_count desc
