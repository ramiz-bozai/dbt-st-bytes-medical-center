{
  "name": "st_bytes_medical_center_demo",
  "description": "dbt (volume read -> silver/gold) -> clustering / metrics view",
  "tasks": [
    {
      "task_key": "dbt_build",
      "dbt_task": {
        "project_directory": "/Workspace/Users/<you>/dbt-st-bytes-medical-center",
        "profiles_directory": "",
        "commands": [
          "dbt deps",
          "dbt build --target prod"
        ]
      },
      "description": "Staging streams the bundled Synthea CSVs from the customer UC volume via read_files(), then builds intermediate models and marts. The committed profiles.yml reads customer-specific connection values from environment variables. Set SQL warehouse to None (Manual), leave catalog/schema unset, and see 'Configuring the Databricks dbt task' in README.md."
    },
    {
      "task_key": "uc_post_dbt_sql",
      "depends_on": [{ "task_key": "dbt_build" }],
      "sql_task": {
        "warehouse_id": "<SQL_WAREHOUSE_ID>",
        "file": {
          "path": "/Workspace/Users/<you>/dbt-st-bytes-medical-center/databricks/optimization/01_automatic_liquid_clustering.sql"
        }
      }
    },
    {
      "task_key": "metrics_view",
      "depends_on": [{ "task_key": "dbt_build" }],
      "sql_task": {
        "warehouse_id": "<SQL_WAREHOUSE_ID>",
        "file": {
          "path": "/Workspace/Users/<you>/dbt-st-bytes-medical-center/databricks/metrics/02_encounter_volume_metrics_view.sql"
        }
      }
    },
    {
      "task_key": "refresh_mv",
      "depends_on": [{ "task_key": "dbt_build" }],
      "sql_task": {
        "warehouse_id": "<SQL_WAREHOUSE_ID>",
        "file": {
          "path": "/Workspace/Users/<you>/dbt-st-bytes-medical-center/databricks/optimization/02_refresh_materialized_view.sql"
        }
      }
    }
  ],
  "tags": {
    "demo": "st_bytes_medical_center",
    "domain": "healthcare",
    "platform": "lakehouse"
  }
}
